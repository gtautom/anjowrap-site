# Numero de destino do WhatsApp, formato internacional, so digitos.
# Exemplo para Belem/PA: 55 + 91 + numero
NEXT_PUBLIC_WHATSAPP=5591900000000

# URL canonica de producao (usada em metadata, sitemap e robots)
NEXT_PUBLIC_SITE_URL=https://anjowrap.com.br

# Chave de API do Asaas — ENV DE SERVIDOR, sem prefixo NEXT_PUBLIC_.
# NEXT_PUBLIC_ inlina a variavel no bundle do browser; com esse prefixo a
# chave vazaria pro codigo publico. Configurar no painel do Netlify, nunca
# aqui com valor real.
ASAAS_API_KEY=

# "production" troca a base da API do Asaas de sandbox pra producao.
# Deixar vazio/sandbox ate o fluxo estar testado ponta a ponta.
ASAAS_ENV=sandbox

# Liga o formulario de assinatura em /servicos. Desligada (padrao ou "0"),
# o bloco do plano cai no CTA de WhatsApp. So ligar depois que ASAAS_API_KEY
# de producao estiver configurada no Netlify.
NEXT_PUBLIC_PLANO_ATIVO=0
